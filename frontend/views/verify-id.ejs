<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Verify Your Identity - Servily</title>
    <link rel="stylesheet" href="/index.css" />
    <style>
      .verify-wrapper {
        max-width: 760px;
        margin: 60px auto;
        padding: 0 24px;
      }

      .verify-card {
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 18px;
        padding: 32px;
        animation: fadeUp 0.6s ease both;
      }

      .verify-card h1 {
        font-family: "DM Serif Display", serif;
        font-size: 1.8rem;
        margin-bottom: 8px;
      }

      .verify-card > p {
        font-size: 0.88rem;
        color: var(--muted);
        margin-bottom: 28px;
        padding-bottom: 14px;
        border-bottom: 1px solid var(--border);
      }

      .form-group {
        margin-bottom: 20px;
      }

      .form-group label {
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--muted);
        display: block;
        margin-bottom: 6px;
      }

      .form-group input,
      .form-group select {
        width: 100%;
        background: var(--bg);
        border: 1.5px solid var(--border);
        border-radius: 10px;
        padding: 10px 14px;
        font-family: "DM Sans", sans-serif;
        font-size: 0.92rem;
        color: var(--text);
        outline: none;
        transition: border-color 0.2s;
      }

      .form-group input:focus,
      .form-group select:focus {
        border-color: var(--accent);
      }

      .file-label {
        display: inline-block;
        background: var(--accent);
        color: var(--text);
        padding: 10px 20px;
        border-radius: 50px;
        font-size: 0.85rem;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.2s;
        margin-top: 8px;
      }

      .file-label:hover {
        background: var(--accent-dark);
      }

      .id-preview {
        max-width: 100%;
        margin-top: 12px;
        border-radius: 12px;
        display: none;
        border: 1px solid var(--border);
      }

      .info-text {
        font-size: 0.75rem;
        color: var(--muted);
        margin-top: 16px;
        padding: 12px;
        background: var(--bg);
        border-radius: 10px;
        text-align: center;
      }

      .btn-submit {
        background: var(--text);
        color: white;
        width: 100%;
        padding: 12px;
        border: none;
        border-radius: 50px;
        font-size: 0.9rem;
        font-weight: 600;
        cursor: pointer;
        margin-top: 24px;
        transition: opacity 0.2s;
      }

      .btn-submit:hover {
        opacity: 0.8;
      }

      .cancel-link {
        display: block;
        text-align: center;
        margin-top: 20px;
        color: var(--muted);
        text-decoration: none;
        font-size: 0.85rem;
      }

      .cancel-link:hover {
        color: var(--text);
      } 
      .flash {
  padding: 12px 16px;
  border-radius: 12px;
  margin-bottom: 20px;
}

.flash.success {
  background: #e7f7ea;
  color: #1f7a3a;
  border: 1px solid #bde5c6;
}

.flash.error {
  background: #fde8e8;
  color: #b42318;
  border: 1px solid #f5b5b5;
}
    </style>
  </head>
  <body> 
      <% if (messages && messages.success) { %>
    <div class="flash success"><%= messages.success %></div>
  <% } %>
  
  <% if (messages && messages.error) { %>
    <div class="flash error"><%= messages.error %></div>
  <% } %>

    <nav>
      <a href="/" class="logo">
        Servily<span>.</span> <small><%= user.role %></small>
      </a>
      <div class="nav-links">
        <a href="/tasks">Browse tasks</a>
        <a href="/profile">Profile</a>
      </div>
      <div class="nav-cta">
        <form action="/logout" method="POST">
          <button type="submit" class="btn-ghost">Log out</button>
        </form>
      </div>
    </nav>

    <div class="verify-wrapper">
      <div class="verify-card">
        <h1>Verify Your Identity</h1>
        <p>Provide your information exactly as it appears on your ID</p>

        <form
          action="/profile/upload-id"
          method="POST"
          enctype="multipart/form-data"
          id="idForm"
        >
          <div class="form-group">
            <label>First Name (as on ID)</label>
            <input
              type="text"
              name="idFirstName"
              required
              placeholder="e.g., Brik"
            />
          </div>

          <div class="form-group">
            <label>Last Name (as on ID)</label>
            <input
              type="text"
              name="idLastName"
              required
              placeholder="e.g., Mouaadh"
            />
          </div>

          <div class="form-group">
            <label>Date of Birth</label>
            <input type="date" name="dateOfBirth" required />
          </div>

          <div class="form-group">
            <label>Place of Birth</label>
            <input
              type="text"
              name="placeOfBirth"
              required
              placeholder="e.g., Algiers"
            />
          </div>

          <div class="form-group">
            <label>ID Number</label>
            <input type="text" name="idNumber" required placeholder="9-digit ID number" 
         pattern="[0-9]{9}" maxlength="9" 
         title="ID number must be exactly 9 digits">
          </div>

          <div class="form-group">
            <label>ID Type</label>
            <select name="idType" required>
              <option value="">Select ID Type</option>
              <option value="national_id">National ID Card</option>
              <option value="passport">Passport</option>
              <option value="drivers_license">Driver's License</option>
            </select>
          </div>

          <div class="form-group">
            <label>Upload Photo of Your ID</label>
            <input
              type="file"
              name="idPhoto"
              accept="image/*"
              required
              id="idInput"
              style="display: none"
            />
            <button
              type="button"
              class="file-label"
              onclick="document.getElementById('idInput').click()"
            >
              Upload ID Photo
            </button>
            <img id="preview" class="id-preview" />
          </div>

          <div class="info-text">
            Your information will be verified by our team. This process helps
            keep our community safe.
          </div>

          <button type="submit" class="btn-submit">Submit Verification</button>
        </form>

        <a href="/profile" class="cancel-link">Cancel</a>
      </div>
    </div>

    <script>
      document
        .getElementById("idInput")
        .addEventListener("change", function (e) {
          const preview = document.getElementById("preview");
          if (e.target.files[0]) {
            const reader = new FileReader();
            reader.onload = function (event) {
              preview.src = event.target.result;
              preview.style.display = "block";
            };
            reader.readAsDataURL(e.target.files[0]);
          }
        });
    </script>
  </body>
</html>
