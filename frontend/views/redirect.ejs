<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Servily</title>
    <link rel="stylesheet" href="/index.css" />

    <style>
      body {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 100vh;
        background: var(--bg);
      }

      .redirect-box {
        text-align: center;
      }

      .redirect-logo {
        font-family: "DM Serif Display", serif;
        font-size: 2.5rem;
        margin-bottom: 10px;
      }

      .redirect-logo span {
        color: var(--accent-dark);
      }

      .redirect-role {
        font-family: "DM Serif Display", serif;
        font-size: 1.1rem;
        color: var(--accent-dark);
        margin-bottom: 20px;
        letter-spacing: 0.3px;
      }

      .redirect-loader {
        width: 30px;
        height: 30px;
        border: 3px solid var(--border);
        border-top: 3px solid var(--text);
        border-radius: 50%;
        margin: 0 auto;
        animation: spin 0.8s linear infinite;
      }

      @keyframes spin {
        to {
          transform: rotate(360deg);
        }
      }
    </style>
  </head>

  <body>
    <div class="redirect-box">
      <div class="redirect-logo">Servily<span>.</span></div>

      <div class="redirect-role"><%= user ? user.role : "" %></div>

      <div class="redirect-loader"></div>
    </div>

    <script>
      const role = "<%= user ? user.role : "" %>";

      setTimeout(() => {
        if (role === "client") {
          window.location.href = "/";
        } else if (role === "worker") {
          window.location.href = "/";
        } else {
          window.location.href = "/login";
        }
      }, 2000);
    </script>
  </body>
</html>
