<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Admin - ID Verifications</title>
  <link rel="stylesheet" href="/index.css">
  <style>
    .admin-wrapper {
      max-width: 900px;
      margin: 60px auto;
      padding: 0 24px;
    }

    .admin-header {
      margin-bottom: 30px;
    }

    .admin-header h1 {
      font-size: 1.8rem;
      font-weight: 600;
      margin-bottom: 8px;
    }

    .admin-header p {
      color: var(--muted);
      font-size: 0.9rem;
    }

    .verification-card {
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 24px;
      margin-bottom: 24px;
      transition: transform 0.2s;
    }

    .verification-card:hover {
      transform: translateY(-2px);
    }

    .verification-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 16px;
      padding-bottom: 12px;
      border-bottom: 1px solid var(--border);
    }

    .verification-header h3 {
      font-size: 1.2rem;
      font-weight: 600;
    }

    .pending-badge {
      background: #fff3cd;
      color: #856404;
      padding: 4px 12px;
      border-radius: 50px;
      font-size: 0.7rem;
      font-weight: 600;
    }

    .verification-details {
      background: var(--bg);
      border-radius: 12px;
      padding: 16px;
      margin: 16px 0;
    }

    .detail-row {
      display: flex;
      margin-bottom: 10px;
      font-size: 0.9rem;
    }

    .detail-label {
      font-weight: 600;
      color: var(--muted);
      width: 110px;
    }

    .detail-value {
      color: var(--text);
    }

    /* Small clickable image */
    .id-photo-wrapper {
      margin-top: 12px;
    }

    .id-photo-thumb {
      max-width: 150px;
      max-height: 150px;
      border-radius: 8px;
      border: 1px solid var(--border);
      cursor: pointer;
      transition: transform 0.2s;
    }

    .id-photo-thumb:hover {
      transform: scale(1.05);
    }

    /* Modal for full-size image */
    .image-modal {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0, 0, 0, 0.9);
      z-index: 9999;
      cursor: pointer;
      align-items: center;
      justify-content: center;
    }

    .image-modal img {
      max-width: 90%;
      max-height: 90%;
      border-radius: 8px;
    }

    .image-modal .close-modal {
      position: absolute;
      top: 20px;
      right: 35px;
      color: white;
      font-size: 40px;
      font-weight: bold;
      cursor: pointer;
    }

    .action-buttons {
      display: flex;
      gap: 12px;
      margin-top: 20px;
    }

    .btn-approve {
      background: var(--text);
      color: white;
      border: none;
      padding: 10px 24px;
      border-radius: 50px;
      font-family: 'DM Sans', sans-serif;
      font-size: 0.85rem;
      font-weight: 600;
      cursor: pointer;
      transition: opacity 0.2s;
    }

    .btn-approve:hover {
      opacity: 0.8;
    }

    .btn-reject {
      background: transparent;
      color: #e00;
      border: 1.5px solid #e00;
      padding: 10px 24px;
      border-radius: 50px;
      font-family: 'DM Sans', sans-serif;
      font-size: 0.85rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s;
    }

    .btn-reject:hover {
      background: #e00;
      color: white;
    }

    .empty-state {
      text-align: center;
      padding: 60px;
      background: var(--card-bg);
      border-radius: 16px;
      border: 1px solid var(--border);
    }

    .empty-state h3 {
      font-size: 1.3rem;
      font-weight: 600;
      margin-bottom: 10px;
    }

    .empty-state p {
      color: var(--muted);
    }

    .flash {
      padding: 12px 16px;
      border-radius: 12px;
      margin-bottom: 20px;
    }

    .flash.success {
      background: #e7f7ea;
      color: #1f7a3a;
      border: 1px solid #bde5c6;
    }

    .flash.error {
      background: #fde8e8;
      color: #b42318;
      border: 1px solid #f5b5b5;
    } 
    /* Admin Inbox Dropdown Styles */
.notification-wrapper {
  position: relative;
  display: inline-block;
}

.inbox-link {
  text-decoration: none;
  color: var(--muted);
  font-size: 0.9rem;
  font-weight: 500;
  transition: color 0.2s;
  position: relative;
}

.inbox-link:hover {
  color: var(--text);
}

.inbox-badge {
  position: absolute;
  top: -8px;
  right: -12px;
  background: #ef4444;
  color: white;
  font-size: 0.65rem;
  padding: 2px 6px;
  border-radius: 50px;
}

.inbox-dropdown {
  position: fixed !important;
  top: 60px !important;
  right: 200px !important;
  width: 320px !important;
  background: var(--card-bg) !important;
  border: 1px solid var(--border) !important;
  border-radius: 12px !important;
  box-shadow: 0 10px 25px rgba(0,0,0,0.1) !important;
  z-index: 999999 !important;
  overflow: hidden !important;
}

.inbox-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12px 16px;
  background: var(--bg);
  border-bottom: 1px solid var(--border);
  font-weight: 600;
  font-size: 0.85rem;
  color: var(--text);
}

.inbox-header a {
  font-size: 0.75rem;
  color: var(--muted);
  text-decoration: none;
}

.inbox-header a:hover {
  color: var(--text);
}

.inbox-list {
  max-height: 350px;
  overflow-y: auto;
}

.inbox-item {
  padding: 12px 16px;
  border-bottom: 1px solid var(--border);
  transition: background 0.2s;
  cursor: pointer;
}

.inbox-item:hover {
  background: var(--bg);
}

.inbox-message {
  font-size: 0.85rem;
  color: var(--text);
  margin-bottom: 4px;
  line-height: 1.4;
}

.inbox-time {
  font-size: 0.7rem;
  color: var(--muted);
}

.inbox-empty,
.inbox-loading {
  padding: 20px;
  text-align: center;
  color: var(--muted);
  font-size: 0.85rem;
}
  </style>
</head>
<body>

  <nav>
    <a href="/" class="logo">
      Servily<span>.</span> <small>Admin</small>
    </a>
    <div class="nav-links">
      <div class="notification-wrapper">
  <a href="#" class="inbox-link" onclick="toggleAdminInbox(); return false;">
    Verifications
    <span id="adminBadge" class="inbox-badge" style="display: none;">0</span>
  </a>
</div>
      <a href="/">Home</a> 

    </div>
    <div class="nav-cta">
      <form action="/logout" method="POST">
        <button type="submit" class="btn-ghost">Log out</button>
      </form>
    </div>
  </nav>
 <div id="adminDropdown" class="inbox-dropdown" style="display: none;">
  <div class="inbox-header">
    <span>New Verification Requests</span>
    <a href="/admin/verifications">View all</a>
  </div>
  <div id="adminInboxList" class="inbox-list">
    <div class="inbox-loading">Loading...</div>
  </div>
</div>
  <div class="admin-wrapper">
    <div class="admin-header">
      <h1>ID Verification Requests</h1>
      <p>Review and verify user identities</p>
    </div>

    <% if (messages && messages.success) { %>
      <div class="flash success"><%= messages.success %></div>
    <% } %>

    <% if (messages && messages.error) { %>
      <div class="flash error"><%= messages.error %></div>
    <% } %>

    <% if (users && users.length > 0) { %>
      <% users.forEach(user => { %> 
        <div class="verification-card">
          <div class="verification-header">
            <h3><%= user.idFullName || user.firstName + ' ' + user.lastName %></h3>
            <span class="pending-badge">Pending</span>
          </div>

          <div class="verification-details">
            <div class="detail-row">
              <span class="detail-label">Email:</span>
              <span class="detail-value"><%= user.email %></span>
            </div>
            <div class="detail-row">
              <span class="detail-label">Role:</span>
              <span class="detail-value"><%= user.role %></span>
            </div>
            <div class="detail-row">
              <span class="detail-label">ID Number:</span>
              <span class="detail-value"><%= user.idNumber || 'Not provided' %></span>
            </div>
            <div class="detail-row">
              <span class="detail-label">Date of Birth:</span>
              <span class="detail-value"><%= user.idDateOfBirth ? user.idDateOfBirth.toLocaleDateString() : 'Not provided' %></span>
            </div>
            <div class="detail-row">
              <span class="detail-label">Place of Birth:</span>
              <span class="detail-value"><%= user.idPlaceOfBirth || 'Not provided' %></span>
            </div>
            <div class="detail-row">
              <span class="detail-label">ID Type:</span>
              <span class="detail-value"><%= user.idType || 'Not provided' %></span>
            </div>
          </div>

          <% if (user.idPhoto) { %>
            <div class="id-photo-wrapper">
              <img src="<%= user.idPhoto %>" class="id-photo-thumb" onclick="openImageModal(this.src)">
            </div>
          <% } %>

          <div class="action-buttons">
            <form action="/admin/approve/<%= user._id %>" method="POST">
              <button type="submit" class="btn-approve">Approve</button>
            </form>
           <button type="button" class="btn-reject" onclick="openRejectModal('<%= user._id %>')">Reject</button>
          </div>
        </div>
      <% }) %>
    <% } else { %>
      <div class="empty-state">
        <h3>No pending verifications</h3>
        <p>All users have been verified.</p>
      </div>
    <% } %>
  </div>

  <!-- Image Modal -->
  <div id="imageModal" class="image-modal" onclick="closeImageModal()">
    <span class="close-modal">&times;</span>
    <img id="modalImage" src="">
  </div>
<!-- Reject Modal -->
<div id="rejectModal" style="display: none; position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); background: var(--card-bg); padding: 24px; border-radius: 16px; z-index: 1000; min-width: 350px; box-shadow: 0 4px 20px rgba(0,0,0,0.15);">
  <h3 style="margin-bottom: 16px;">Reject ID Verification</h3>
  <form action="" method="POST" id="rejectForm">
    <textarea name="reason" required placeholder="Please provide a reason for rejection..." rows="4" style="width: 100%; padding: 10px; border: 1px solid var(--border); border-radius: 8px; font-family: inherit; margin-bottom: 16px;"></textarea>
    <div style="display: flex; gap: 12px; justify-content: flex-end;">
      <button type="button" class="btn-ghost" onclick="closeRejectModal()" style="padding: 8px 16px;">Cancel</button>
      <button type="submit" class="btn-reject" style="padding: 8px 16px;">Confirm Reject</button>
    </div>
  </form>
</div>

<!-- Modal Overlay -->
<div id="modalOverlay" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 999;" onclick="closeRejectModal()"></div>

<script>
  function openRejectModal(userId) {
    const modal = document.getElementById('rejectModal'); 
    console.log("UserId received:", userId);
    const overlay = document.getElementById('modalOverlay');
    const form = document.getElementById('rejectForm');
    
    form.action = '/admin/reject/' + userId;
    modal.style.display = 'block';
    overlay.style.display = 'block';
  }
  
  function closeRejectModal() {
    const modal = document.getElementById('rejectModal');
    const overlay = document.getElementById('modalOverlay');
    
    modal.style.display = 'none';
    overlay.style.display = 'none';
  }
</script>
  <script>
    function openImageModal(imageSrc) {
      const modal = document.getElementById('imageModal');
      const modalImg = document.getElementById('modalImage');
      modal.style.display = 'flex';
      modalImg.src = imageSrc;
    }

    function closeImageModal() {
      const modal = document.getElementById('imageModal');
      modal.style.display = 'none';
    }

    // Close with Escape key
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        closeImageModal();
      }
    }); 

    async function loadAdminInbox() {
  try {
    const response = await fetch('/inbox/admin-requests');
    const data = await response.json();
    
    const badge = document.getElementById('adminBadge');
    const listContainer = document.getElementById('adminInboxList');
    
    if (data.notifications.length === 0) {
      listContainer.innerHTML = '<div class="inbox-empty">No new verification requests</div>';
      return;
    }
    
    let html = '';
    data.notifications.forEach(notif => {
      const date = new Date(notif.createdAt);
      const timeAgo = getTimeAgo(date);
      
      html += `
        <div class="inbox-item">
          <div class="inbox-message">${notif.message}</div>
          <div class="inbox-time">${timeAgo}</div>
        </div>
      `;
    });
    
    listContainer.innerHTML = html;
    
    // Mark as read when dropdown opens
    if (data.unreadCount > 0) {
      await fetch('/inbox/mark-read', { method: 'POST' });
      badge.style.display = 'none';
    }
    
  } catch (error) {
    console.error('Error loading admin inbox:', error);
    document.getElementById('adminInboxList').innerHTML = '<div class="inbox-empty">Failed to load</div>';
  }
}
function toggleAdminInbox() {
  const dropdown = document.getElementById('adminDropdown');
  if (dropdown.style.display === 'none' || dropdown.style.display === '') {
    dropdown.style.display = 'block';
    loadAdminInbox();
  } else {
    dropdown.style.display = 'none';
  }
}

// Close admin dropdown when clicking outside
document.addEventListener('click', function(event) {
  const wrapper = document.querySelector('.notification-wrapper');
  const dropdown = document.getElementById('adminDropdown');
  if (wrapper && !wrapper.contains(event.target) && dropdown && !dropdown.contains(event.target)) {
    dropdown.style.display = 'none';
  }
});

// Load admin unread count on page load
async function loadAdminUnreadCount() {
  try {
    const response = await fetch('/inbox/admin-unread-count');
    const data = await response.json();
    const badge = document.getElementById('adminBadge');
    if (data.count > 0) {
      badge.textContent = data.count;
      badge.style.display = 'inline';
    } else {
      badge.style.display = 'none';
    }
  } catch (error) {
    console.error('Error loading admin unread count:', error);
  }
}
loadAdminUnreadCount(); 

function getTimeAgo(date) {
  const seconds = Math.floor((new Date() - new Date(date)) / 1000);
  
  if (seconds < 60) return 'just now';
  const minutes = Math.floor(seconds / 60);
  if (minutes < 60) return `${minutes} min ago`;
  const hours = Math.floor(minutes / 60);
  if (hours < 24) return `${hours} hour${hours > 1 ? 's' : ''} ago`;
  const days = Math.floor(hours / 24);
  return `${days} day${days > 1 ? 's' : ''} ago`;
}
  </script>

</body>
</html>