<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <title>Servily - My Tasks</title>
  <link rel="stylesheet" href="/index.css" />

  <style>
    .flash-container {
      position: fixed;
      top: 80px;
      left: 50%;
      transform: translateX(-50%);
      z-index: 9999;

      width: 100%;
      max-width: 420px;
      padding: 0 16px;
    }

    .flash {
      padding: 12px 16px;
      border-radius: 12px;
      font-size: 0.85rem;

      border: 1px solid;
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);

      animation: slideDown 0.25s ease;
      margin-bottom: 10px;
    }

    .flash.success {
      background: #e7f7ea;
      color: #1f7a3a;
      border-color: #bde5c6;
    }

    .flash.error {
      background: #fde8e8;
      color: #b42318;
      border-color: #f5b5b5;
    }

    @keyframes slideDown {
      from {
        opacity: 0;
        transform: translateY(-10px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .modal {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.35);
      backdrop-filter: blur(6px);
      z-index: 200; 
      
    }

 .modal-content {
  background: var(--card-bg);
  border: 1px solid var(--border);
  border-radius: 18px;
  width: 420px;
  max-width: 90%;
  margin: 40px auto;
  padding: 28px;
  position: relative;
  max-height: calc(100vh - 80px);  /* Limit height */
  overflow-y: auto;  /* Scroll inside modal if needed */
}

    .modal-content h2 {
      font-family: "DM Serif Display", serif;
      font-size: 1.4rem;
      margin-bottom: 18px;
    }

    .modal-content input,
    .modal-content textarea,
    .modal-content select {
      width: 100%;
      background: #f0f0ee;
      border: 1.5px solid transparent;
      border-radius: 10px;
      padding: 10px 14px;
      font-family: "DM Sans", sans-serif;
      font-size: 0.9rem;
      margin-bottom: 12px;
      outline: none;
      transition: border-color 0.2s;
    }

    .modal-content input:focus,
    .modal-content textarea:focus,
    .modal-content select:focus {
      border-color: var(--text);
    }

    .close {
      position: absolute;
      right: 16px;
      top: 12px;
      font-size: 18px;
      cursor: pointer;
      color: var(--muted);
    }

    .close:hover {
      color: var(--text);
    }

    /* ================= TASK GRID ================= */

    .task-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
    }

    .task-card {
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 16px;
      overflow: hidden;
      transition: 0.2s; 
       position: relative;
    }

    .task-card:hover {
      transform: translateY(-4px);
    }

    .task-img {
      width: 100%;
      height: 150px;
      background: #eee;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .task-img img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .task-placeholder {
      font-size: 2rem;
      font-weight: bold;
      color: var(--text);
    }

    .task-info {
      padding: 14px;
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .task-info h3 {
      font-size: 1rem;
      margin: 0;
    }

    .task-desc {
      font-size: 0.85rem;
      color: var(--muted);
    }

    .task-location,
    .task-category {
      font-size: 0.8rem;
      color: var(--muted);
    }

    .task-status {
      font-size: 0.75rem;
      font-weight: 600;
      padding: 4px 10px;
      border-radius: 50px;
      width: fit-content;
      background: #e7f7ea;
      color: #1f7a3a;
    }

    /* ================= RESPONSIVE ================= */

    @media (max-width: 900px) {
      .task-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (max-width: 600px) {
      .task-grid {
        grid-template-columns: 1fr;
      }
    }

    /* ACTION CONTAINER */
    .task-actions {
     display: flex;
  align-items: flex-start;
margin-top: 10px;
    }   

     .btn-edit {
  position: absolute;
  top: 12px;
  right: 12px;

  background: transparent;
  border: 1px solid var(--border);
  color: var(--text);

  padding: 4px 10px;
  font-size: 0.75rem;
  border-radius: 50px;

  cursor: pointer;
  transition: all 0.2s ease;
}


.btn-edit:hover {
  background: var(--card-bg);
  border-color: var(--text);
}

    /* DELETE BUTTON */
    .btn-delete {
      width: 100%;
      background: transparent;
      border: 1px solid #d92d20;
      color: #d92d20;
      padding: 8px 12px;
      border-radius: 50px;
      font-size: 0.8rem;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    /* HOVER */
    .btn-delete:hover {
      background: #d92d20;
      color: #fff;
      transform: translateY(-1px);
    }
  </style>
</head>

<body>
<% if (messages && messages.success) { %>
  <div class="flash success"><%= messages.success %></div>
<% } %>

<% if (messages && messages.error) { %>
  <div class="flash error"><%= messages.error %></div>
<% } %>

  <!-- NAV -->
  <nav>
    <a href="/" class="logo">
      Servily<span>.</span> <small><%= user.role %></small>
    </a>

    <div class="nav-links">
      <a href="#">Messages</a>
      <a href="/profile">Profile</a>
    </div>

    <div class="nav-cta">
      <form action="/logout" method="POST">
        <button class="btn-ghost">Logout</button>
      </form>
    </div>
  </nav>

  <!-- HEADER -->
  <section class="section">
    <div class="section-header">
      <h2>My Tasks</h2>

      <button class="btn-ghost" onclick="openModal()">
        Create Task
      </button>
    </div>
  </section>

  <!-- TASK GRID -->
  <section class="section">

    <% if (!tasks || tasks.length === 0) { %>

    <div class="hero-card">
      <h3>No tasks yet</h3>
      <p>Your posted tasks will appear here.</p>
    </div>

    <% } else { %>

    <div class="task-grid"> <% tasks.forEach(task => { %> <div class="task-card">
        <div class="task-img"> <% if (task.image) { %> <img src="<%= task.image %>" /> <% } else { %> <div class="task-placeholder"> <%= task.name.charAt(0) %> </div> <% } %> </div>
        <div class="task-info">
          <h3><%= task.name %></h3>
          <p class="task-desc"> <%= task.description %> </p>
          <p class="task-location"> <%= task.baladiya %>, <%= task.wilaya %> </p>
          <p class="task-category"> <%= task.category %> </p> <span class="task-status"> <%= task.status %> </span> 
          <button type="button" class="btn-edit" onclick='openEditModal(<%- JSON.stringify(task) %>)'>Edit</button>
          <form action="/tasks/delete/<%= task._id %>" method="POST" class="task-actions"> <button type="submit" class="btn-delete"> Delete Task </button> </form>
        </div>
      </div> <% }) %> </div>

    <% } %>

  </section>


  <!-- MODAL -->
  <div id="taskModal" class="modal">

    <div class="modal-content">

      <span class="close" onclick="closeModal()">×</span>

      <div style="text-align:center; margin-bottom: 20px;">
        <div class="logo" style="font-size: 1.6rem;">
          Servily<span>.</span>
        </div>
        <small id="modalTitleText" style="color: var(--muted);">Create a new task</small>
      </div>

      <form action="/tasks/create" method="POST"> 


        <input type="text" name="name" placeholder="Task title" required />

        <textarea name="description" placeholder="Describe the task..." required></textarea>

        <input type="text" name="category" placeholder="Category" required /> 

        <div class="field">
  <label>Number of Workers Needed</label>
  <input type="number" name="neededWorkers" min="1" value="1" required>
</div>

        <select name="wilaya" id="wilaya" required>
          <option value="">Select Wilaya</option>
        </select>

        <select name="baladiya" id="baladiya" required>
          <option value="">Select Baladiya</option>
        </select>
        <input type="file" name="images" multiple />


        <button type="submit" class="btn-hero" style="width: 100%;">
          Create Task
        </button>

      </form>

    </div>

  </div> 

  <!-- EDIT MODAL -->
<div id="editTaskModal" class="modal">

  <div class="modal-content">

    <span class="close" onclick="closeEditModal()">×</span>

    <div style="text-align:center; margin-bottom: 20px;">
      <div class="logo" style="font-size: 1.6rem;">
        Servily<span>.</span>
      </div>
      <small style="color: var(--muted);">Edit your task</small>
    </div>

    <form id="editTaskForm" method="POST" enctype="multipart/form-data">

      <input type="text" name="name" placeholder="Task title" required />

      <textarea name="description" placeholder="Describe the task..." required></textarea>

      <input type="text" name="category" placeholder="Category" required />

      <select name="wilaya" id="editWilaya" required>
        <option value="">Select Wilaya</option>
      </select>

      <select name="baladiya" id="editBaladiya" required>
        <option value="">Select Baladiya</option>
      </select>

<input type="file" name="taskImage"  multiple accept="image/*" />
      
<button type="submit" class="btn-hero" style="width: 100%;">
        Update Task
      </button>

    </form>

  </div>

</div>

  <!-- JS -->
  <script>
    function openModal() {
      document.getElementById("taskModal").style.display = "block";
    }

    function closeModal() {
      document.getElementById("taskModal").style.display = "none"; 
      
    }

    window.onclick = function(e) {
      const modal = document.getElementById("taskModal");
      if (e.target === modal) modal.style.display = "none";
    };

    // DATA
    const wilayas = <%- JSON.stringify(wilayas) %>;
    const data = <%- JSON.stringify(algeria) %>;

    const wilayaSelect = document.getElementById("wilaya");
    const baladiyaSelect = document.getElementById("baladiya");

    // fill wilayas
    wilayas.forEach(w => {
      const option = document.createElement("option");
      option.value = w;
      option.textContent = w;
      wilayaSelect.appendChild(option);
    });

    // dynamic baladiya
    wilayaSelect.addEventListener("change", () => {

      baladiyaSelect.innerHTML = '<option value="">Select Baladiya</option>';

      const filtered = data.filter(item =>
        item.wilaya_name_ascii === wilayaSelect.value
      );

      filtered.forEach(item => {
        const option = document.createElement("option");
        option.value = item.commune_name_ascii;
        option.textContent = item.commune_name_ascii;
        baladiyaSelect.appendChild(option);
      });

    });


    setTimeout(() => {
      document.querySelectorAll(".flash").forEach(el => {
        el.style.transition = "0.3s";
        el.style.opacity = "0";
        el.style.transform = "translateY(-10px)";
        setTimeout(() => el.remove(), 300);
      });
    }, 3000);  

    // fill wilayas in edit modal
wilayas.forEach(w => {
  const option = document.createElement("option");
  option.value = w;
  option.textContent = w;
  editWilaya.appendChild(option);
});  

editWilaya.addEventListener("change", () => {

  editBaladiya.innerHTML = '<option value="">Select Baladiya</option>';

  const filtered = data.filter(item =>
    item.wilaya_name_ascii === editWilaya.value
  );

  filtered.forEach(item => {
    const option = document.createElement("option");
    option.value = item.commune_name_ascii;
    option.textContent = item.commune_name_ascii;
    editBaladiya.appendChild(option);
  });

});

function openEditModal(task) { 
  document.getElementById("editTaskModal").style.display = "block";

  const form = document.getElementById("editTaskForm");
  form.action = "/tasks/edit/" + task._id; 

  const editWilaya = document.getElementById("editWilaya");
const editBaladiya = document.getElementById("editBaladiya");


  // fill fields
  form.querySelector("input[name='name']").value = task.name || "";
  form.querySelector("textarea[name='description']").value = task.description || "";
  form.querySelector("input[name='category']").value = task.category || "";

  document.getElementById("editWilaya").value = task.wilaya || "";

  setTimeout(() => {
    document.getElementById("editBaladiya").value = task.baladiya || "";
  }, 100);
}

function closeEditModal() {
  document.getElementById("editTaskModal").style.display = "none";
}
  </script>

</body>

</html>