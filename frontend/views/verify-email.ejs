<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Verify Email - Servily</title>
  <link rel="stylesheet" href="/index.css" />
  <style>
    .verify-container {
      max-width: 500px;
      margin: 100px auto;
      padding: 40px;
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 20px;
      text-align: center;
    }
    .verify-container h1 {
      font-family: 'DM Serif Display', serif;
      font-size: 1.8rem;
      margin-bottom: 20px;
    }
    .code-input {
      width: 200px;
      text-align: center;
      font-size: 24px;
      letter-spacing: 8px;
      padding: 12px;
      margin: 20px auto;
      border: 2px solid var(--border);
      border-radius: 12px;
      background: var(--bg);
      color: var(--text);
    }
    .btn-verify {
      background: var(--text);
      color: white;
      border: none;
      padding: 12px 30px;
      border-radius: 50px;
      font-size: 1rem;
      cursor: pointer;
      width: 100%;
    }
    .resend-link {
      display: block;
      margin-top: 20px;
      color: var(--muted);
    }
    .flash {
      padding: 10px;
      margin-bottom: 20px;
      border-radius: 8px;
    }
    .flash.success {
      background: #d4edda;
      color: #155724;
      border: 1px solid #c3e6cb;
    }
    .flash.error {
      background: #f8d7da;
      color: #721c24;
      border: 1px solid #f5c6cb;
    }
  </style>
</head>
<body>

  <nav>
    <a href="/" class="logo">Servily<span>.</span></a>
  </nav>

  <div class="verify-container">
    <h1>Verify Your Email</h1>
    <p>Please enter the 6-digit code sent to your email</p>
    
    <% if (messages && messages.success) { %>
      <div class="flash success"><%= messages.success %></div>
    <% } %>
    <% if (messages && messages.error) { %>
      <div class="flash error"><%= messages.error %></div>
    <% } %>
    
    <form action="/verify-email" method="POST">
      <input type="text" name="code" class="code-input" placeholder="000000" maxlength="6" required autofocus />
      <button type="submit" class="btn-verify">Verify Email</button>
    </form>
    
    <a href="/resend-verification" class="resend-link">Didn't receive code? Resend</a>
  </div>

</body>
</html>