<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Servily – Find Trusted Local Professionals</title>
    <link rel="stylesheet" href="index.css" />
  </head>
  <body>
    <!-- NAVBAR -->
    <nav>
      <a href="/" class="logo">Servily<span>.</span></a>
      <div class="nav-links">
        <a href="#">How it works</a>
        <a href="#">Services</a>
        <a href="#">Support</a>
      </div>
      <div class="nav-cta">
        <a href="/login" class="btn-ghost">Log In</a>
        <a href="/signup" class="btn-solid">Sign Up</a>
      </div>
    </nav>

    <!-- HERO -->
    <section class="hero">
      <!-- LEFT SIDE -->
      <div class="hero-left">
        <div class="hero-tag">Verified Professionals</div>

        <h1>Find reliable local workers for any job</h1>

        <p>
          Connect with trusted professionals for home repairs, maintenance,
          moving, and technical help in your area.
        </p>

        <div class="hero-metrics-row">
          <div class="metric-item">
            <strong>100%</strong>
            <span>ID Verified</span>
          </div>

          <div class="metric-item">
            <strong>Fast</strong>
            <span>Responses</span>
          </div>

          <div class="metric-item">
            <strong>Free</strong>
            <span>To Post</span>
          </div>
        </div>
      </div>

      <!-- RIGHT SIDE -->
      <div class="hero-search-wrapper">
        <div class="hero-search-card">
          <div class="search-top">
            <span class="search-badge">Quick Search</span>
            <h3>Find the right professional</h3>
            <p>Search trusted workers near your area instantly.</p>
          </div>

          <div class="hero-search-panel">
            <div class="search-field">
              <span class="field-label">Service</span>
              <input type="text" placeholder="Plumber, Electrician..." />
            </div>

            <div class="search-field">
              <span class="field-label">Location</span>
              <input type="text" placeholder="Choose your city" />
            </div>

            <button class="btn-search">Search Now</button>
          </div>
        </div>
      </div>
    </section>

    <!-- CATEGORIES -->
    <section class="section">
      <div class="section-header">
        <h2>Browse popular services</h2>
        <a href="/signup">See all categories →</a>
      </div>
      <div class="categories">
        <a href="/signup" class="cat-card">
          <span class="cat-code">01</span>
          <div class="cat-name">Plumbing</div>
          <div class="cat-count">340+ workers</div>
        </a>
        <a href="/signup" class="cat-card">
          <span class="cat-code">02</span>
          <div class="cat-name">Electricity</div>
          <div class="cat-count">290+ workers</div>
        </a>
        <a href="/signup" class="cat-card">
          <span class="cat-code">03</span>
          <div class="cat-name">Heating & AC</div>
          <div class="cat-count">180+ workers</div>
        </a>
        <a href="/signup" class="cat-card">
          <span class="cat-code">04</span>
          <div class="cat-name">Moving & Transport</div>
          <div class="cat-count">210+ workers</div>
        </a>
        <a href="/signup" class="cat-card">
          <span class="cat-code">05</span>
          <div class="cat-name">Masonry & Painting</div>
          <div class="cat-count">190+ workers</div>
        </a>
        <a href="/signup" class="cat-card">
          <span class="cat-code">06</span>
          <div class="cat-name">Carpentry</div>
          <div class="cat-count">152 workers</div>
        </a>
        <a href="/signup" class="cat-card">
          <span class="cat-code">07</span>
          <div class="cat-name">Home & Office Cleaning</div>
          <div class="cat-count">420+ workers</div>
        </a>
        <a href="/signup" class="cat-card">
          <span class="cat-code">08</span>
          <div class="cat-name">Tech & IT Support</div>
          <div class="cat-count">110+ workers</div>
        </a>
      </div>
    </section>

    <!-- HOW IT WORKS -->
    <section class="how">
      <h2>How it works</h2>
      <div class="steps">
        <div class="step">
          <div class="step-num">01</div>
          <h3>Post a job</h3>
          <p>
            Tell us what you need done, your location, and your schedule. It
            takes less than two minutes.
          </p>
        </div>
        <div class="step">
          <div class="step-num">02</div>
          <h3>Get quotes</h3>
          <p>
            Receive prices from available local workers. Chat with them, check
            their profiles, and pick the best fit.
          </p>
        </div>
        <div class="step">
          <div class="step-num">03</div>
          <h3>Get it done</h3>
          <p>
            The worker completes the job as agreed. Confirm everything is
            finished perfectly before leaving a review.
          </p>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="cta">
      <h2>Ready to get your task done?</h2>
      <div class="cta-actions">
        <a href="/signup" class="btn-hero">Post a Job</a>
        <a href="/signup" class="btn-ghost">Become a Worker</a>
      </div>
    </section>

    <!-- FOOTER -->
    <footer>
      <a href="/" class="footer-logo">Servily<span>.</span></a>
      <span>© 2026 Servily. All rights reserved.</span>
    </footer>
  </body>
</html>
