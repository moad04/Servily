<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Servily – Find trusted professionals in Algeria</title>
    <link rel="stylesheet" href="index.css" />
  </head>
  <body>
    <!-- NAVBAR -->
    <nav>
      <a href="/" class="logo">Servily<span>.</span></a>
      <div class="nav-links">
        <a href="#">How it works</a>
        <a href="#">Categories</a>
        <a href="#">Become a worker</a>
      </div>
      <div class="nav-cta">
        <a href="/login" class="btn-ghost">Log In</a>
        <a href="/signup" class="btn-solid">Sign Up</a>
      </div>
    </nav>

    <!-- HERO -->
    <section class="hero">
      <div class="hero-left">
        <div class="hero-tag">Algeria's #1 Service Platform</div>
        <h1>Get any task<br />done <em>fast</em> &<br />professionally</h1>
        <p>
          Connect with trusted local professionals for cleaning, repairs,
          moving, and more — anywhere in Algeria.
        </p>
        <div class="hero-actions">
          <a href="/signup" class="btn-hero">Post a task for free</a>
          <span class="hero-note">No subscription required</span>
        </div>
      </div>

      <div class="hero-right">
        <div class="hero-card tall">
          <div class="card-icon">🔧</div>
          <h3>Home Repairs</h3>
          <p>
            Plumbing, electricity, painting and more from verified
            professionals.
          </p>
        </div>
        <div class="hero-card accent-card">
          <div class="stat">2.4k+</div>
          <div class="stat-label">Active workers</div>
        </div>
        <div class="hero-card">
          <div class="card-icon">⚡</div>
          <h3>Fast matching</h3>
          <p>Get offers within minutes.</p>
        </div>
      </div>
    </section>

    <!-- CATEGORIES -->
    <section class="section">
      <div class="section-header">
        <h2>Browse by category</h2>
        <a href="/signup">See all →</a>
      </div>
      <div class="categories">
        <a href="/signup" class="cat-card">
          <div class="cat-icon">🧹</div>
          <div class="cat-name">Cleaning</div>
          <div class="cat-count">120+ workers</div>
        </a>
        <a href="/signup" class="cat-card">
          <div class="cat-icon">🔧</div>
          <div class="cat-name">Plumbing</div>
          <div class="cat-count">85+ workers</div>
        </a>
        <a href="/signup" class="cat-card">
          <div class="cat-icon">⚡</div>
          <div class="cat-name">Electricity</div>
          <div class="cat-count">97+ workers</div>
        </a>
        <a href="/signup" class="cat-card">
          <div class="cat-icon">🚚</div>
          <div class="cat-name">Moving</div>
          <div class="cat-count">64+ workers</div>
        </a>
        <a href="/signup" class="cat-card">
          <div class="cat-icon">🎨</div>
          <div class="cat-name">Painting</div>
          <div class="cat-count">73+ workers</div>
        </a>
        <a href="/signup" class="cat-card">
          <div class="cat-icon">🌿</div>
          <div class="cat-name">Gardening</div>
          <div class="cat-count">41+ workers</div>
        </a>
        <a href="/signup" class="cat-card">
          <div class="cat-icon">💻</div>
          <div class="cat-name">Tech Support</div>
          <div class="cat-count">58+ workers</div>
        </a>
        <a href="/signup" class="cat-card">
          <div class="cat-icon">🛠️</div>
          <div class="cat-name">Assembly</div>
          <div class="cat-count">49+ workers</div>
        </a>
      </div>
    </section>

    <!-- HOW IT WORKS -->
    <section class="how">
      <h2>How Servily works</h2>
      <div class="steps">
        <div class="step">
          <div class="step-num">01</div>
          <h3>Post your task</h3>
          <p>
            Describe what you need done, where, and when. It takes less than 2
            minutes.
          </p>
        </div>
        <div class="step">
          <div class="step-num">02</div>
          <h3>Receive offers</h3>
          <p>
            Verified workers send you offers with their price. Chat with them
            before deciding.
          </p>
        </div>
        <div class="step">
          <div class="step-num">03</div>
          <h3>Get it done</h3>
          <p>
            Choose the best offer, pay securely, and get your task completed
            professionally.
          </p>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="cta">
      <h2>Ready to get your first task done?</h2>
      <div class="cta-actions">
        <a href="/signup" class="btn-hero">Post a task</a>
        <a href="/signup" class="btn-ghost">Become a worker</a>
      </div>
    </section>

    <!-- FOOTER -->
    <footer>
      <a href="/" class="footer-logo">Servily<span>.</span></a>
      <span>© 2025 Servily. All rights reserved.</span>
    </footer>
  </body>
</html>
