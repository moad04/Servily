 <!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Servily - Client</title>
    <link rel="stylesheet" href="/index.css" /> 
    <style>
      .carousel {
  position: relative;
  display: flex;
  align-items: center;
  gap: 10px;
}

.carousel-viewport {
  overflow: hidden;
  width: 100%;
}

.carousel-track {
  display: flex;
  gap: 16px;
  scroll-behavior: smooth;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  padding: 10px 0;
}

.worker-card {
  flex: 0 0 calc(33.333% - 11px);
  background: var(--card-bg);
  border: 1px solid var(--border);
  border-radius: 16px;
  overflow: hidden;
  scroll-snap-align: start;
  display: flex;
  flex-direction: column;
  transition: transform 0.2s ease;
}

.worker-card:hover {
  transform: translateY(-4px);
}

.worker-img {
  width: 100%;
  height: 140px;
  background-color: #eee;
  background-position: center;
  background-repeat: no-repeat;
  background-size: cover; /* This acts like object-fit: cover */
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex-shrink: 0; /* Prevents the container itself from squishing */
}

/* We don't need the .worker-img img rule anymore if using the method below */

.worker-avatar {
  width: 60px;
  height: 60px;
  border-radius: 50%;
  background: var(--text);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22px;
  font-weight: bold;
}

/* INFO AREA */
.worker-info {
  padding: 12px 14px;
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.worker-info h3 {
  font-size: 1rem;
  margin: 0;
}

.worker-skills {
  font-size: 0.85rem;
  color: var(--muted);
}

.worker-status {
  font-size: 0.75rem;
  font-weight: 600;
  margin-top: 6px;
}

.worker-status.available {
  color: green;
}

.worker-status.busy {
  color: red;
}
.carousel-btn {
  background: var(--text);
  color: #fff;
  border: none;
  width: 36px;
  height: 36px;
  border-radius: 50%;
  cursor: pointer;
  font-size: 18px;
}

.carousel-btn:hover {
  opacity: 0.8;
} 
.stars {
  display: inline-flex;
  align-items: center;
  gap: 2px;
  margin-left: 6px;
}

.star {
  width: 14px;
  height: 14px;
  display: inline-block;
  background: #ddd;
  clip-path: polygon(
    50% 0%,
    61% 35%,
    98% 35%,
    68% 57%,
    79% 91%,
    50% 70%,
    21% 91%,
    32% 57%,
    2% 35%,
    39% 35%
  );
}

.star.filled {
  background: #111;
}

.star.half {
  background: linear-gradient(90deg, #111 50%, #ddd 50%);
}

.rating-number {
  font-size: 0.8rem;
  color: var(--muted);
  margin-left: 6px;
} 

.worker-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 10px;
}

.btn-offer {
  background: var(--text);
  color: #fff;
  border: 1px solid var(--text);
  padding: 6px 12px;
  border-radius: 50px;
  font-size: 0.75rem;
  cursor: pointer;
  transition: 0.2s;
}

.btn-offer:hover {
  opacity: 0.85;
  transform: translateY(-1px);
} 
.card {
  background: var(--card-bg);
  border: 1px solid var(--border);
  border-radius: 16px;
  overflow: hidden;
  transition: transform 0.2s ease;
} 
.task-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18px;
}

/* CARD */
.task-card {
  background: var(--card-bg);
  border: 1px solid var(--border);
  border-radius: 16px;
  overflow: hidden;
  transition: 0.2s;
}

.task-card:hover {
  transform: translateY(-4px);
}

/* IMAGE */
.task-img {
  width: 100%;
  height: 150px;
  background: #eee;
  display: flex;
  align-items: center;
  justify-content: center;
}

.task-img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.task-placeholder {
  font-size: 2rem;
  font-weight: bold;
  color: var(--text);
}

/* CONTENT */
.task-info {
  padding: 14px;
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.task-info h3 {
  font-size: 1rem;
}

.task-desc {
  font-size: 0.85rem;
  color: var(--muted);
}

.task-location,
.task-category {
  font-size: 0.8rem;
  color: var(--muted);
}

/* ================= TASK STATUS BADGES ================= */

.task-status {
  font-size: 0.75rem;
  font-weight: 600;
  padding: 4px 10px;
  border-radius: 50px;
  width: fit-content;
  display: inline-block;
}

/* OPEN */
.task-status.open {
  background: #e7f7ea;
  color: #1f7a3a;
  border: 1px solid #bde5c6;
}

/* IN PROGRESS */
.task-status.progress,
.task-status.in-progress {
  background: #fff6e5;
  color: #a66a00;
  border: 1px solid #ffd89a;
}

/* COMPLETED */
.task-status.completed {
  background: #e7efff;
  color: #1f4fd6;
  border: 1px solid #b8ccff;
}

/* CANCELLED */
.task-status.cancelled {
  background: #fde8e8;
  color: #b42318;
  border: 1px solid #f5b5b5;
} 
/* Inbox Dropdown Styles */
.notification-wrapper {
  position: relative;
  display: inline-block;
}

.inbox-link {
  text-decoration: none;
  color: var(--muted);
  font-size: 0.9rem;
  font-weight: 500;
  transition: color 0.2s;
  position: relative;
}

.inbox-link:hover {
  color: var(--text);
}

.inbox-badge {
  position: absolute;
  top: -8px;
  right: -12px;
  background: #ef4444;
  color: white;
  font-size: 0.65rem;
  padding: 2px 6px;
  border-radius: 50px;
}

.inbox-dropdown {
  position: fixed !important;
  top: 60px !important;
  right: 200px !important;
  width: 320px !important;
  background: var(--card-bg) !important;
  border: 1px solid var(--border) !important;
  border-radius: 12px !important;
  box-shadow: 0 10px 25px rgba(0,0,0,0.1) !important;
  z-index: 999999 !important;
  overflow: hidden !important;
}

.inbox-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12px 16px;
  background: var(--bg);
  border-bottom: 1px solid var(--border);
  font-weight: 600;
  font-size: 0.85rem;
  color: var(--text);
}

.inbox-header a {
  font-size: 0.75rem;
  color: var(--muted);
  text-decoration: none;
}

.inbox-header a:hover {
  color: var(--text);
}

.inbox-list {
  max-height: 350px;
  overflow-y: auto;
}

.inbox-item {
  padding: 12px 16px;
  border-bottom: 1px solid var(--border);
  transition: background 0.2s;
  cursor: pointer;
}

.inbox-item:hover {
  background: var(--bg);
}

.inbox-item.unread {
  background: rgba(200, 240, 74, 0.1);
  border-left: 3px solid var(--accent);
}

.inbox-message {
  font-size: 0.85rem;
  color: var(--text);
  margin-bottom: 4px;
  line-height: 1.4;
}

.inbox-time {
  font-size: 0.7rem;
  color: var(--muted);
}

.inbox-empty,
.inbox-loading {
  padding: 30px;
  text-align: center;
  color: var(--muted);
  font-size: 0.85rem;
}
    </style>
  </head>
  <body>   
  <% if (hasNewApplications) { %>
  <div id="newAppPopup" style="position: fixed; top: 80px; left: 50%; transform: translateX(-50%); background: #22c55e; color: white; border-radius: 12px; padding: 16px 24px; box-shadow: 0 10px 40px rgba(0,0,0,0.2); z-index: 10000; text-align: center; animation: slideDown 0.3s ease;">
    <div style="font-weight: bold; font-size: 16px; margin-bottom: 5px;">
      Hello <%= user.firstName %>!
    </div>
    <div style="font-size: 14px;">
      You have <strong><%= newApplicationsCount %></strong> new application(s) for your tasks.
      <a href="/application/client-applications" style="color: white; text-decoration: underline; margin-left: 5px;">Check your applications</a>
    </div>
    <button onclick="closePopup()" style="position: absolute; top: 5px; right: 10px; background: none; border: none; color: white; font-size: 18px; cursor: pointer;">×</button>
  </div>
  
  <style>
    @keyframes slideDown {
      from {
        transform: translateX(-50%) translateY(-100%);
        opacity: 0;
      }
      to {
        transform: translateX(-50%) translateY(0);
        opacity: 1;
      }
    } 
  </style>
  
  <script>
    function closePopup() {
      document.getElementById('newAppPopup').remove();
    }
    
    setTimeout(() => {
      const popup = document.getElementById('newAppPopup');
      if (popup) popup.remove();
    }, 8000);
  </script>
<% } %>
<%- include('partials/flash') %>
 <nav>
  <a href="/" class="logo">
    Servily<span>.</span> <small>Client</small>
  </a>
  <div class="nav-links">
    <a href="/tasks/my">My Tasks</a>
    <a href="/profile">My Profile</a>   
    <a href="/application/client-applications">My Applications</a> 
    
    <div class="notification-wrapper">
      <a href="#" class="inbox-link" onclick="toggleInbox(); return false;">
        Inbox
        <span id="inboxBadge" class="inbox-badge" style="display: none;">0</span>
      </a>
    </div>
  </div>
  
  <div class="nav-cta">
    <form action="/logout" method="POST">
      <button class="btn-ghost">Logout</button>
    </form>
  </div>
</nav>

<div id="inboxDropdown" class="inbox-dropdown" style="display: none;">
  <div class="inbox-header">
    <span>Recent Notifications</span>
    <a href="/inbox">View all</a>
  </div>
  <div id="inboxList" class="inbox-list">
    <div class="inbox-loading">Loading...</div>
  </div>
</div>
    <section class="hero">

  <div class="hero-left">

    <h1>
      Find trusted help for any task
    </h1>

    <p>
      Post a task and connect with nearby verified workers quickly and securely.
    </p>

    <div class="hero-actions">
      <a href="/tasks/my" class="btn-hero">Post a Task</a>
    </div>

  </div>

</section>  

<section class="section">

  <div class="section-header">
    <h2>Available Workers</h2>
  </div>

  <% if (!workers || workers.length === 0) { %>

    <div class="hero-card">
      <h3>No workers available</h3>
      <p>Workers will appear here once they join the platform.</p>
    </div>

  <% } else { %>

    <div class="carousel">

      <button class="carousel-btn left" onclick="scrollWorkers(-1)">‹</button>

      <div class="carousel-viewport">
        <div class="carousel-track" id="workersTrack">

          <% workers.forEach(worker => { %>

            <div class="worker-card">

              <!-- IMAGE -->
<div class="worker-img" 
  <% if (worker.profilePic) { %> 
    style="background-image: url('<%= worker.profilePic %>'); background-size: contain; background-position: center; background-repeat: no-repeat;"
  <% } %>>
  <% if (!worker.profilePic) { %>
    <div class="worker-avatar">
      <%= worker.firstName.charAt(0) %>
    </div>
  <% } %>
</div>

              <!-- INFO -->
              <div class="worker-info">

            <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
  <div style="width: 28px; height: 28px; border-radius: 50%; background: #1a1a1a; color: white; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: bold;">
    <%= worker.firstName.charAt(0) %>
  </div>
  <h3 style="margin: 0;">
    <a href="/profile/<%= worker._id %>" style="text-decoration: none; color: inherit;">
      <%= worker.firstName %> <%= worker.lastName %>
    </a>
  </h3>
  <% if (worker.isIdVerified) { %>
    <span style="background: #e7f7ea; color: #1f7a3a; font-size: 0.6rem; font-weight: 600; padding: 2px 8px; border-radius: 50px; border: 1px solid #bde5c6;">
      Verified
    </span>
  <% } %>
</div>

                <!-- LOCATION (same as before) -->
                <p class="worker-skills">
                  <%= worker.location || worker.wilaya || "Unknown" %>
                </p>

                <!-- SKILLS -->
                <p class="worker-skills">
                  <%= worker.skills?.length ? worker.skills.join(", ") : "No skills listed" %>
                </p>

                <!-- TASKS COMPLETED -->
                <p class="worker-skills">
                  Tasks completed: <%= worker.tasksCompleted || 0 %>
                </p>

                <!-- RATING (your stars system) -->
                <div>
                  <% const rating = worker.rating || 0; %>

                  <span class="stars">
                    <% for (let i = 1; i <= 5; i++) { %>
                      <span class="star <%= i <= Math.floor(rating) ? 'filled' : '' %>"></span>
                    <% } %>
                  </span>

                  <span class="rating-number">
                    <%= rating || "New" %>
                  </span>
                </div>

                <!-- STATUS + BUTTON (same idea you had) -->
                <div class="worker-actions">

                  <span class="worker-status <%= worker.isavailable ? 'available' : 'busy' %>">
                    <%= worker.isavailable ? "Available" : "Busy" %>
                  </span>

                  <button class="btn-offer">
                    Offer a job
                  </button>

                </div>

              </div>

            </div>

          <% }) %>

        </div>
      </div>

      <button class="carousel-btn right" onclick="scrollWorkers(1)">›</button>

    </div>

  <% } %>

</section>

</section>
<section class="section">

  <div class="section-header">
    <h2>Available Tasks</h2>
  </div>

  <% if (!tasks || tasks.length === 0) { %>

    <div class="hero-card">
      <h3>No tasks available</h3>
      <p>New tasks will appear here soon.</p>
    </div>

  <% } else { %>

    <div class="task-grid">

      <% tasks.forEach(task => { %>

        <div class="task-card">

          <!-- IMAGE -->
          <div class="task-img">
            <% if (task.image) { %>
              <img src="<%= task.image %>" alt="task image" />
            <% } else { %>
              <div class="task-placeholder">
                <%= task.name.charAt(0) %>
              </div>
            <% } %>
          </div>

          <!-- CONTENT -->
          <div class="task-info">

            <h3><%= task.name %></h3>

            <p class="task-desc">
              <%= task.description %>
            </p>

            <!-- CLIENT INFO with clickable name -->
            <div class="task-client" style="display: flex; align-items: center; gap: 8px; margin-top: 8px; padding-top: 8px; border-top: 1px solid var(--border);">
              <div style="width: 24px; height: 24px; border-radius: 50%; background: var(--accent); display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: bold;">
                <%= task.client?.firstName?.charAt(0) || '?' %>
              </div>
              <span style="font-size: 0.8rem; color: var(--text);">
                Posted by: <strong><a href="/profile/<%= task.client?._id %>" style="text-decoration: none; color: inherit;"><%= task.client?.firstName %> <%= task.client?.lastName %></a></strong>
              </span>
            </div>

            <p class="task-location">
               <%= task.baladiya %>, <%= task.wilaya %>
            </p>

            <p class="task-category">
               <%= task.category %>
            </p>

            <span class="task-status <%= (task.status || '').toLowerCase().replace(' ', '-') %>">
              <%= task.status %>
            </span>

          </div>

        </div>

      <% }) %>

    </div>

  <% } %>

</section>
</body>
<script>
  const track = document.getElementById("workersTrack");

  function scrollWorkers(direction) {
    const card = track.querySelector(".worker-card");

    if (!card) return;

    const cardWidth = card.offsetWidth;
    const gap = 16; // must match CSS gap
    const scrollAmount = (cardWidth + gap) * 3; // 3 cards at a time

    track.scrollBy({
      left: direction * scrollAmount,
      behavior: "smooth"
    });
  } 

</script> 

<script>
async function loadInbox() {
  try {
    const response = await fetch('/inbox/recent');
    const data = await response.json();
    
    const badge = document.getElementById('inboxBadge');
    if (data.unreadCount > 0) {
      badge.textContent = data.unreadCount;
      badge.style.display = 'inline';
    } else {
      badge.style.display = 'none';
    }
    
    const listContainer = document.getElementById('inboxList');
    
    if (data.notifications.length === 0) {
      listContainer.innerHTML = '<div class="inbox-empty">No notifications</div>';
      return;
    }
    
    let html = '';
    data.notifications.forEach(notif => {
      const date = new Date(notif.createdAt);
      const timeAgo = getTimeAgo(date);
      
      html += `
        <div class="inbox-item ${notif.read ? '' : 'unread'}">
          <div class="inbox-message">${notif.message}</div>
          <div class="inbox-time">${timeAgo}</div>
        </div>
      `;
    });
    
    listContainer.innerHTML = html;
    
    // Mark as read when dropdown opens
    if (data.unreadCount > 0) {
      await fetch('/inbox/mark-read', { method: 'POST' });
      badge.style.display = 'none';
    }
    
  } catch (error) {
    console.error('Error loading inbox:', error);
    document.getElementById('inboxList').innerHTML = '<div class="inbox-empty">Failed to load</div>';
  }
}

function toggleInbox() { 
  console.log("toggleInbox clicked");
  const dropdown = document.getElementById('inboxDropdown'); 
  console.log("dropdown element found:", dropdown);
  console.log("Current display style:", dropdown.style.display);
  
  if (dropdown.style.display === 'none' || dropdown.style.display === '') {
    console.log("Opening dropdown...");
    dropdown.style.display = 'block';
    loadInbox();
  } else {
    console.log("Closing dropdown...");
    dropdown.style.display = 'none';
  }
}

// Close dropdown when clicking outside
document.addEventListener('click', function(event) {
  const wrapper = document.querySelector('.notification-wrapper');
  if (wrapper && !wrapper.contains(event.target)) {
    document.getElementById('inboxDropdown').style.display = 'none';
  }
});

// Helper function for time ago
function getTimeAgo(date) {
  const seconds = Math.floor((new Date() - date) / 1000);
  
  if (seconds < 60) return 'just now';
  const minutes = Math.floor(seconds / 60);
  if (minutes < 60) return `${minutes} min ago`;
  const hours = Math.floor(minutes / 60);
  if (hours < 24) return `${hours} hour${hours > 1 ? 's' : ''} ago`;
  const days = Math.floor(hours / 24);
  return `${days} day${days > 1 ? 's' : ''} ago`;
}

// Load unread count on page load
async function loadUnreadCount() {
  try {
    const response = await fetch('/inbox/unread-count');
    const data = await response.json();
    const badge = document.getElementById('inboxBadge');
    if (data.count > 0) {
      badge.textContent = data.count;
      badge.style.display = 'inline';
    }
  } catch (error) {
    console.error('Error loading unread count:', error);
  }
}

loadUnreadCount();
</script>
</html>