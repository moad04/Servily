<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Worker Dashboard</title>
  <link rel="stylesheet" href="/index.css" /> 
  <style>
    .job-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
  gap: 16px;
}

.job-card {
  background: var(--card-bg);
  border: 1px solid var(--border);
  border-radius: 16px;
  padding: 18px;

  transition: transform 0.2s, box-shadow 0.2s;
}

.job-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 10px 25px rgba(0,0,0,0.08);
}

.job-card h3 {
  font-family: "DM Serif Display", serif;
  margin-bottom: 8px;
}

.job-desc {
  font-size: 0.85rem;
  color: var(--muted);
  margin-bottom: 12px;
}

.job-meta {
  display: flex;
  justify-content: space-between;
  font-size: 0.8rem;
  color: var(--text);
  margin-bottom: 10px;
}

.job-client {
  font-size: 0.8rem;
  color: var(--muted);
} 
/* =========================
   WORKER JOBS (TASK STYLE)
   ========================= */

.task-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18px;
}

/* CARD */
.task-card {
  background: var(--card-bg);
  border: 1px solid var(--border);
  border-radius: 16px;
  overflow: hidden;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.task-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 10px 25px rgba(0,0,0,0.08);
}

/* IMAGE SECTION */
.task-img {
  width: 100%;
  height: 160px;
  background: #eee;
  display: flex;
  align-items: center;
  justify-content: center;
}

.task-img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.task-placeholder {
  font-size: 2rem;
  font-weight: bold;
  color: var(--text);
}

/* CONTENT */
.task-info {
  padding: 14px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.task-info h3 {
  font-size: 1.05rem;
  margin: 0;
}

/* DESCRIPTION */
.task-desc {
  font-size: 0.85rem;
  color: var(--muted);
  line-height: 1.4;
}

/* META TEXT */
.task-location,
.task-category {
  font-size: 0.8rem;
  color: var(--muted);
}

/* STATUS BADGE (you already have logic) */
.task-status {
  font-size: 0.75rem;
  font-weight: 600;
  padding: 4px 10px;
  border-radius: 50px;
  width: fit-content;
  display: inline-block;
}

/* OPEN */
.task-status.open {
  background: #e7f7ea;
  color: #1f7a3a;
  border: 1px solid #bde5c6;
}

/* IN PROGRESS */
.task-status.progress,
.task-status.in-progress {
  background: #fff6e5;
  color: #a66a00;
  border: 1px solid #ffd89a;
}

/* COMPLETED */
.task-status.completed {
  background: #e7efff;
  color: #1f4fd6;
  border: 1px solid #b8ccff;
}

/* CANCELLED */
.task-status.cancelled {
  background: #fde8e8;
  color: #b42318;
  border: 1px solid #f5b5b5;
}

/* ACTION BUTTON */
.task-card .btn-ghost {
  width: 100%;
  margin-top: 10px;
} 

.client-link {
  color: var(--text);
  font-weight: 600;
  text-decoration: none;
  transition: 0.2s;
}

.client-link:hover {
  text-decoration: underline;
  opacity: 0.8;
}  

.view-all-link {
  display: inline-block;
  color: var(--text);
  font-weight: 600;
  text-decoration: none;
  padding: 8px 14px;
  border: 1px solid var(--border);
  border-radius: 50px;
  transition: 0.2s ease;
}

.view-all-link:hover {
  background: var(--text);
  color: white;
}

  </style>
</head>

<body> 

   <% if (hasRejectionNotification) { %>
    <div id="rejectionPopup" style="position: fixed; top: 80px; left: 50%; transform: translateX(-50%); background: #ef4444; color: white; border-radius: 12px; padding: 16px 24px; box-shadow: 0 10px 40px rgba(0,0,0,0.2); z-index: 10000; text-align: center; animation: slideDown 0.3s ease;">
      <div style="font-weight: bold; font-size: 16px; margin-bottom: 5px;">
        Hello <%= user.firstName %>!
      </div>
      <div style="font-size: 14px;">
        You have <strong><%= rejectionCount %></strong> application(s) that were rejected.
        <a href="/application/worker-applications" style="color: white; text-decoration: underline; margin-left: 5px;">View details</a>
      </div>
      <button onclick="closeRejectionPopup()" style="position: absolute; top: 5px; right: 10px; background: none; border: none; color: white; font-size: 18px; cursor: pointer;">×</button>
    </div>
    
    <style>
      @keyframes slideDown {
        from {
          transform: translateX(-50%) translateY(-100%);
          opacity: 0;
        }
        to {
          transform: translateX(-50%) translateY(0);
          opacity: 1;
        }
      }
    </style>
    
    <script>
      function closeRejectionPopup() {
        document.getElementById('rejectionPopup').remove();
      }
      setTimeout(() => {
        const popup = document.getElementById('rejectionPopup');
        if (popup) popup.remove();
      }, 8000);
    </script>
  <% } %>

  <!-- NAV -->
  <nav>
    <a href="/" class="logo">
      Servily<span>.</span> <small><%= user ? user.role : "" %></small>
    </a>

    <div class="nav-links">
      <a href="/tasks">Available Jobs</a>
      <a href="/profile">Profile</a>
      <a href="#">Earnings</a>
      <a href="/application/worker-applications">My applications</a>
    </div>

    <div class="nav-cta">
      <form action="/logout" method="POST">
        <button class="btn-ghost">Logout</button>
      </form>
    </div>
  </nav>

  <!-- 1. JOB FEED -->
<section class="section">

  <div class="section-header">
    <h2>Latest Jobs</h2>
  </div>

  <% if (!tasks || tasks.length === 0) { %>

    <div class="hero-card">
      <h3>No jobs available</h3>
      <p>Check back later for new opportunities.</p>
    </div>

  <% } else { %>

    <div class="task-grid">

      <% tasks.slice(0, 8).forEach(task => { %>

        <div class="task-card">

          <!-- IMAGE / VISUAL BLOCK -->
          <div class="task-img">
            <% if (task.image) { %>
              <img src="<%= task.image %>" />
            <% } else { %>
              <div class="task-placeholder">
                <%= task.name.charAt(0) %>
              </div>
            <% } %>
          </div>

          <!-- CONTENT -->
          <div class="task-info">

            <!-- TITLE -->
            <h3><%= task.name %></h3>

            <!-- DESCRIPTION -->
            <p class="task-desc">
              <%= task.description 
                ? task.description.substring(0, 120)  
                : "No description provided" %>
            </p>

            <!-- LOCATION -->
            <p class="task-location">
              <strong>Location:</strong>
              <%= task.baladiya %>, <%= task.wilaya %>
            </p>

            <!-- CATEGORY -->
            <p class="task-category">
              <strong>Category:</strong> <%= task.category %>
            </p>

    <!-- CLIENT -->
<p class="task-category">
  <strong>Posted by:</strong>
  <div style="display: inline-flex; align-items: center; gap: 6px;">
    <div style="width: 22px; height: 22px; border-radius: 50%; background: var(--accent); display: inline-flex; align-items: center; justify-content: center; font-size: 11px; font-weight: bold;">
      <%= task.client?.firstName?.charAt(0) || '?' %>
    </div>
   <a href="/profile/<%= task.client?._id %>" class="client-link">
     <%= task.client?.firstName %> <%= task.client?.lastName %>
    </a>
  </div>
</p>

            <!-- STATUS -->
            <span class="task-status <%= (task.status || '').toLowerCase().replace(' ', '-') %>">
              <%= task.status %>
            </span>  

            <p class="task-category">
  Workers needed: <%= task.neededWorkers || 1 %>
</p>

            


          <a href="/tasks/view-task/<%= task._id %>" class="btn-ghost">
  View Job
</a>
           

          </div>

        </div>

      <% }) %>

    </div>

  <% } %>

</section> 
<div style="margin-top: 20px; text-align: center;">
  <a href="/tasks" class="view-all-link">View all tasks</a>
</div>
  <!-- 2. TRUSTED CLIENTS -->
  <section class="section">

    <div class="section-header">
      <h2>Trusted Clients</h2>
    </div>

    <div class="categories">

      <div class="cat-card">
        <div class="cat-name">Premium Client</div>
        <div class="cat-count">High budget • Verified</div>
      </div>

      <div class="cat-card">
        <div class="cat-name">Regular Client</div>
        <div class="cat-count">Good rating • Active</div>
      </div>

      <div class="cat-card">
        <div class="cat-name">New Client</div>
        <div class="cat-count">Recently joined</div>
      </div>

    </div>

  </section>

</body>
</html>